{
  "name": "claude-monitor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "hooks:install": "node install.mjs",
    "hooks:uninstall": "node install.mjs --uninstall",
    "service:install": "node service.mjs",
    "service:uninstall": "node service.mjs --uninstall",
    "service:stop": "node service.mjs --stop",
    "service:start": "node service.mjs --start",
    "service:restart": "node service.mjs --restart"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318"
  }
}
